<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.Sup_Controller">
	 <top>
	 	<StackPane>
        	<Label layoutX="50" style="-fx-font-size: 20px; -fx-padding: 10; -fx-font-weight: bold;" text="SUPPLIER MANAGEMENT" />
        </StackPane>
    </top>
    <center>
        <TableView fx:id="tableView" prefHeight="400" prefWidth="600">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="150" text="Supplier ID" />
                <TableColumn fx:id="nameColumn" prefWidth="350" text="Name" />
                <TableColumn fx:id="phoneColumn" prefWidth="300" text="Phone" />
                <TableColumn fx:id="emailColumn" prefWidth="450" text="Email" />
            </columns>
        </TableView>
    </center>
    <bottom>
	    <HBox alignment="CENTER" spacing="10">
		    <padding>
		        <Insets bottom="10" left="30" right="30" top="10" />
		    </padding>
         	<Button fx:id="searchButton" maxWidth="Infinity" onAction="#handleSearch" text="Search" HBox.hgrow="ALWAYS" />
	        <Button fx:id="addButton" maxWidth="Infinity" onAction="#handleAdd" text="Add" HBox.hgrow="ALWAYS" />
	        <Button fx:id="editButton" maxWidth="Infinity" onAction="#handleEdit" text="Edit" HBox.hgrow="ALWAYS" />
	        <Button fx:id="deleteButton" maxWidth="Infinity" onAction="#handleDelete" text="Delete" HBox.hgrow="ALWAYS" />
	        <Button fx:id="refreshButton" maxWidth="Infinity" onAction="#handleRefresh" text="Refresh" HBox.hgrow="ALWAYS" />
	    </HBox>
	</bottom>
</BorderPane>
