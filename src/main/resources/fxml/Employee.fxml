<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<VBox xmlns="http://javafx.com/javafx"
	  xmlns:fx="http://javafx.com/fxml"
	  fx:controller="GUI.Emp_Controller"
	  spacing="15" style="-fx-padding: 20; -fx-background-color: #f5f5f5;" prefHeight="600.0" prefWidth="820.0">

	<!-- FORM NHẬP NHÂN VIÊN MỚI -->
	<VBox spacing="10" style="-fx-background-color: #ffffff; -fx-padding: 15; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-color: #cccccc;">
		<Label text="➕ Thêm nhân viên mới" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
		<TextField fx:id="idField" promptText="ID"/>
		<TextField fx:id="nameField" promptText="Name"/>
		<TextField fx:id="positionField" promptText="Position"/>
		<TextField fx:id="emailField" promptText="Email"/>
		<TextField fx:id="phoneField" promptText="Phone"/>
		<TextField fx:id="cccdField" promptText="CCCD"/>
		<Button text="Thêm nhân viên" onAction="#handleAddEmployee"/>
	</VBox>

	<!-- DANH SÁCH NHÂN VIÊN -->
	<ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
		<content>
			<VBox fx:id="employeeList" spacing="10"/>
		</content>
	</ScrollPane>

</VBox>