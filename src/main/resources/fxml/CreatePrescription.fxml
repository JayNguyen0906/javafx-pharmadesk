<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.CreatePrescription_Controller">

    <children>
        <VBox alignment="TOP_LEFT" spacing="10">
	        <padding>
		        <Insets top="20" right="20" bottom="20" left="20"/>
		    </padding>
            <children>
                <Label text="Kê đơn thuốc" style="-fx-font-size: 24px; -fx-font-weight: bold;" />

                <HBox spacing="10">
                    <children>
                        <Label text="Tên bệnh nhân:" />
                        <TextField fx:id="txtPatientName" promptText="Nhập tên bệnh nhân" />
                    </children>
                </HBox>

                <HBox spacing="10">
                    <children>
                        <Label text="Tên thuốc:" />
                        <TextField fx:id="txtMedicineName" promptText="Nhập tên thuốc" />
                    </children>
                </HBox>

                <HBox spacing="10">
                    <children>
                        <Label text="Liều lượng:" />
                        <TextField fx:id="txtDosage" promptText="Nhập liều dùng" />
                    </children>
                </HBox>

                <Button fx:id="btnSavePrescription" text="Lưu đơn thuốc" onAction="#handleSave" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
            </children>
        </VBox>
    </children>
</AnchorPane>
