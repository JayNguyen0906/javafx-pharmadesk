<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="600.0" prefWidth="654.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.Cus_Controller">
	<top>
	    <HBox alignment="CENTER" spacing="10" >
	    	<padding>
		        <Insets bottom="10" left="0" right="0" top="10" />
		    </padding>
	        <ImageView fitHeight="40.0" fitWidth="45.0">
	            <image>
	                <Image url="@/img/Customer.png" />
	            </image>
	        </ImageView>
	        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="CUSTOMER MANAGEMENT" textAlignment="CENTER">
	            <font>
	                <Font name="System Bold" size="24.0" />
	            </font>
	        </Text>
	    </HBox>
	</top>
		
	<center>
		<TableView fx:id="tableView" prefHeight="223.0" prefWidth="635.0">
			<columns>
				<TableColumn fx:id="id" prefWidth="180" text="ID" />
				<TableColumn fx:id="name" prefWidth="300" text="Name" />
				<TableColumn fx:id="phone" prefWidth="280" text="Phone" />
				<TableColumn fx:id="address" prefWidth="400" text="Address" />
			</columns>
		</TableView>
     </center>
     <bottom>
    	 <HBox alignment="CENTER" spacing="10">
		    <padding>
		        <Insets bottom="10" left="30" right="30" top="10" />
		    </padding>
			<Button fx:id="searchButton" maxWidth="Infinity" onAction="#handleSearch" text="Search" HBox.hgrow="ALWAYS" />
	        <Button fx:id="addButton" maxWidth="Infinity" onAction="#handleAdd" text="Add" HBox.hgrow="ALWAYS" />
	        <Button fx:id="editButton" maxWidth="Infinity" onAction="#handleEdit" text="Edit" HBox.hgrow="ALWAYS" />
	        <Button fx:id="deleteButton" maxWidth="Infinity" onAction="#handleDelete" text="Delete" HBox.hgrow="ALWAYS" />
		</HBox>
	</bottom>
</BorderPane>
