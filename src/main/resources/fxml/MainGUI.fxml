            <Button mnemonicParsing="false" prefHeight="30.0" prefWidth="100.0" text="Warehouse" fx:id="btnWarehouse" onAction="#handleWarehouse"/>
         </children>
      </VBox>
   </left>
   <top>
      <Pane prefHeight="193.0" prefWidth="685.0" BorderPane.alignment="CENTER">
