<?import javafx.scene.control.ProgressIndicator?>
<BorderPane prefHeight="600.0" prefWidth="654.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.MainGUI_Controller">
   <center>
