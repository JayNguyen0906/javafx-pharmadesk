<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.Main_Controller">


	    <AnchorPane BorderPane.alignment="CENTER">
	        <children>
	            <ImageView fx:id="headerImage" pickOnBounds="true" preserveRatio="true" >
	                <image>
	                    <Image url="@/img/Banner.png" />
	                </image>
	            </ImageView>
	        </children>
	    </AnchorPane>
	    
	<BorderPane VBox.vgrow="ALWAYS">
    <left>
	    <AnchorPane prefWidth="120.0" BorderPane.alignment="CENTER">
	        <children>
	            <VBox alignment="TOP_CENTER" prefWidth="120.0" spacing="10" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="1.0">
	                <children>
	                    <Button mnemonicParsing="false" onAction="#loadItem" prefWidth="120.0" text="Items" />
	                    <Button mnemonicParsing="false" onAction="#loadCustomer" prefWidth="120.0" text="Customers" />
	                    <Button mnemonicParsing="false" prefWidth="120.0" text="Bill" />
	                    <Button mnemonicParsing="false" onAction="#loadEmployee" prefWidth="120.0" text="Employee" />
	                    <Button mnemonicParsing="false" onAction="#loadSupplier" prefWidth="120.0" text="Supplier" />
	                    <Button mnemonicParsing="false" onAction="#loadWarehouse" prefWidth="120.0" text="Warehouse" />
	                </children>
	            </VBox>
	        </children>
	    </AnchorPane>
	</left>

    <center>
        <StackPane fx:id="mainContent"  prefHeight="768.0" prefWidth="1336.0"> </StackPane>
    </center>
    </BorderPane>
</VBox>
