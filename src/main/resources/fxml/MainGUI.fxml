                  <Image url="@Img/KeDonThuoc.png" />
               </image>
            </ImageView>
            <Button layoutX="431.0" layoutY="343.0" mnemonicParsing="false" style="             -fx-background-color: rgba(255, 255, 255, 0.2);             -fx-text-fill: white;             -fx-background-radius: 20;             -fx-border-color: white;             -fx-border-width: 1;             -fx-border-radius: 20;             -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 4);         " text="Kê đơn thuốc ngay" />
         </children></AnchorPane>
   </center>
