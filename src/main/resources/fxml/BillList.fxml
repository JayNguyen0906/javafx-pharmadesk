<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="GUI.BillList_Controller"
stylesheets="/css/title.css">
    <top>
        <HBox alignment="CENTER" spacing="10" styleClass="title-pane" >
		    	<padding>
			        <Insets bottom="10" left="0" right="0" top="10" />
			    </padding>
		        <ImageView fitHeight="40.0" fitWidth="45.0">
		            <image>
		                <Image url="@/img/bill.png" />
		            </image>
		        </ImageView>
		        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Danh Sách Hóa Đơn" textAlignment="CENTER" styleClass="title-text">
		            <font>
		                <Font name="System Bold" size="24.0" />
		            </font>
		        </Text>
		    </HBox>
    </top>

    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="5" right="2" bottom="0" left="2"/>
            </padding>

            <TableView fx:id="tableBills" style="-fx-font-size: 15;">
                <columns>
                    <TableColumn fx:id="colBillId" text="Mã hóa đơn" prefWidth="110"/>
                    <TableColumn fx:id="colCustomerName" text="Khách hàng" prefWidth="198"/>
                    <TableColumn fx:id="colDate" text="Ngày lập" prefWidth="250"/>
                    <TableColumn fx:id="colTotal" text="Tổng tiền" prefWidth="250"/>
                    <TableColumn fx:id="colDetail" text="Chi tiết" prefWidth="120"/>
                    <TableColumn fx:id="colDelete" text="Xóa" prefWidth="110"/>
                    <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="110"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>