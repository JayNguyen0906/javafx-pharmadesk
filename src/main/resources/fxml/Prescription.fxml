<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Button?>

<StackPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.Prescription_Controller">
	<ImageView fitHeight="575.0" fitWidth="1150.0" preserveRatio="false">
           <image>
                 <Image url="@/img/KeDonThuoc.png" />
           </image>
    </ImageView>
          <AnchorPane pickOnBounds="false">
		       <children>
		           <Button fx:id="btnCreatePrescription" onAction="#handleCreatePrescription"
		           style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: red;                                  
		           -fx-background-radius: 20; -fx-border-color: red; -fx-border-width: 1;                                  
		           -fx-border-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 4);" 
		           text="Kê đơn thuốc ngay" AnchorPane.bottomAnchor="20.0" AnchorPane.rightAnchor="20.0" />
		       </children>
		  </AnchorPane>			
</StackPane>

