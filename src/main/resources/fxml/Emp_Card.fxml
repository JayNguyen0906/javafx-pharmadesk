<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="GUI.Emp_Card_Controller"
      spacing="5"
      prefWidth="250" prefHeight="200" 
	  styleClass="card"
	  stylesheets="/css/card.css">
    <Label fx:id="idLabel"/>
    <Label fx:id="nameLabel"/>
    <Label fx:id="positionLabel"/>
    <Label fx:id="emailLabel"/>
    <Label fx:id="phoneLabel"/>
    <Label fx:id="cccdLabel"/>
    <Button fx:id="attendanceButton" text="✅ Chấm công" onAction="#handleAttendance" />
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="🖋 Sửa" onAction="#handleEdit"/>
        <Button text="❌ Xóa" onAction="#handleDelete"/>
    </HBox>
</VBox>