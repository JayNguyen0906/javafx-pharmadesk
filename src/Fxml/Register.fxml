<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefWidth="600.0" prefHeight="654.0" style="-fx-background-color: linear-gradient(to bottom right, #74ebd5, #acb6e5);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <VBox spacing="15.0" layoutX="50.0" layoutY="50.0" prefWidth="300.0">
            <children>
                <Label text="Sign Up" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #333;" />
                
                <Label text="Full Name" style="-fx-font-weight: bold;" />
                <TextField fx:id="fullNameField" promptText="Enter your full name" />
                
                <Label text="Email Address" style="-fx-font-weight: bold;" />
                <TextField fx:id="emailField" promptText="Enter your email" />
                
                <Label text="Phone Number" style="-fx-font-weight: bold;" />
                <TextField fx:id="phoneField" promptText="Enter your phone number" />
                
                <Label text="Password" style="-fx-font-weight: bold;" />
                <PasswordField fx:id="passwordField" promptText="Create a password" />
                
                <Button fx:id="registerButton" text="Register" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 10px;" />
                
                <Label text="Already have an account? Login" style="-fx-text-fill: #555; -fx-font-size: 12px; -fx-alignment: center;" />
            </children>
        </VBox>
    </children>
</AnchorPane>
